<?xml version="1.0" encoding="UTF-8"?>
<!--
  I stdio-modus eier MCP-protokollen stdout (JSON-RPC). Vi logger derfor til stderr,
  som er ledig og synlig i IntelliJ/konsollet, samt til fil. Dermed ser du Spring-logoen
  og oppstartsloggen uten å korrumpere meldingene til klienten.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_FILE" value="logs/vacation-booking-mcp.log"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
